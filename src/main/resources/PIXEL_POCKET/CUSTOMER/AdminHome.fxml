<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<StackPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="PIXEL_POCKET.CUSTOMER.AdminHome_Controller"
    prefWidth="1200"
    prefHeight="800"
    style="-fx-background-color: linear-gradient(to bottom right, #1D7386, #7F9594);">

    <VBox spacing="0">

        <!-- TOP BAR -->
        <HBox alignment="CENTER_LEFT" prefHeight="60"
            style="-fx-background-color: rgba(30,60,65,0.95);
                   -fx-padding: 0 40;">
            <Label text="PIXEL-POCKET  |  Super Admin"
                style="-fx-font-size: 18;
                       -fx-font-weight: bold;
                       -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout"
                onAction="#handleLogout"
                style="-fx-background-color: #F44336;
                       -fx-background-radius: 8;
                       -fx-text-fill: white;
                       -fx-font-size: 13;
                       -fx-cursor: hand;
                       -fx-padding: 6 20;"/>
        </HBox>

        <!-- STAT CARDS — centred -->
        <HBox spacing="20" alignment="CENTER"
            style="-fx-padding: 24 40 16 40;">
            <VBox prefWidth="180" prefHeight="85"
                alignment="CENTER" spacing="4"
                style="-fx-background-color: rgba(195,200,201,0.15);
                       -fx-background-radius: 12;
                       -fx-border-color: rgba(195,200,201,0.3);
                       -fx-border-radius: 12;
                       -fx-border-width: 1;">
                <Label fx:id="statTotal" text="0"
                    style="-fx-font-size: 30;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>
                <Label text="Total Customers"
                    style="-fx-font-size: 11;
                           -fx-text-fill: #C3C8C9;"/>
            </VBox>
            <VBox prefWidth="180" prefHeight="85"
                alignment="CENTER" spacing="4"
                style="-fx-background-color: rgba(76,175,80,0.2);
                       -fx-background-radius: 12;
                       -fx-border-color: #4CAF50;
                       -fx-border-radius: 12;
                       -fx-border-width: 1;">
                <Label fx:id="statActive" text="0"
                    style="-fx-font-size: 30;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>
                <Label text="Active"
                    style="-fx-font-size: 11;
                           -fx-text-fill: #C3C8C9;"/>
            </VBox>
            <VBox prefWidth="180" prefHeight="85"
                alignment="CENTER" spacing="4"
                style="-fx-background-color: rgba(244,67,54,0.2);
                       -fx-background-radius: 12;
                       -fx-border-color: #F44336;
                       -fx-border-radius: 12;
                       -fx-border-width: 1;">
                <Label fx:id="statDeactivated" text="0"
                    style="-fx-font-size: 30;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>
                <Label text="Deactivated"
                    style="-fx-font-size: 11;
                           -fx-text-fill: #C3C8C9;"/>
            </VBox>
        </HBox>

        <!-- MAIN AREA — centred, equal columns -->
        <HBox spacing="20" alignment="CENTER"
            VBox.vgrow="ALWAYS"
            style="-fx-padding: 0 40 30 40;">

            <!-- LEFT: CUSTOMER LIST -->
            <VBox spacing="10" prefWidth="520">

                <Label text="Customers"
                    style="-fx-font-family: 'Jaldi';
                           -fx-font-size: 18;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>

                <!-- SEARCH -->
                <HBox spacing="8">
                    <TextField fx:id="searchField"
                        promptText="Search name / email / phone..."
                        prefHeight="38"
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-color: rgba(195,200,201,0.15);
                               -fx-background-radius: 20;
                               -fx-border-color: rgba(195,200,201,0.3);
                               -fx-border-radius: 20;
                               -fx-border-width: 1;
                               -fx-text-fill: white;
                               -fx-font-size: 13;
                               -fx-padding: 0 12;
                               -fx-prompt-text-fill: rgba(195,200,201,0.5);
                               -fx-control-inner-background:
                                   rgba(195,200,201,0.15);"/>
                    <Button text="Search"
                        onAction="#handleSearch"
                        prefHeight="38"
                        style="-fx-background-color: #1D7386;
                               -fx-background-radius: 20;
                               -fx-text-fill: white;
                               -fx-cursor: hand;
                               -fx-padding: 0 16;"/>
                    <Button text="All"
                        onAction="#handleShowAll"
                        prefHeight="38"
                        style="-fx-background-color: rgba(195,200,201,0.2);
                               -fx-background-radius: 20;
                               -fx-text-fill: #C3C8C9;
                               -fx-cursor: hand;
                               -fx-padding: 0 16;"/>
                </HBox>

                <!-- TABLE -->
                <TableView fx:id="customersTable"
                    VBox.vgrow="ALWAYS"
                    onMouseClicked="#handleRowClick"
                    style="-fx-background-color: rgba(46,80,87,0.8);
                           -fx-background-radius: 12;">
                    <columns>
                        <TableColumn fx:id="colId"
                            text="ID" prefWidth="55"/>
                        <TableColumn fx:id="colName"
                            text="Name" prefWidth="155"/>
                        <TableColumn fx:id="colEmail"
                            text="Email" prefWidth="200"/>
                        <TableColumn fx:id="colStatus"
                            text="Status" prefWidth="95"/>
                    </columns>
                </TableView>

                <Label text="Click a row to edit →"
                    style="-fx-font-size: 11;
                           -fx-text-fill: rgba(195,200,201,0.5);"/>
            </VBox>

            <!-- RIGHT: EDIT PANEL -->
            <VBox fx:id="editPanel"
                spacing="14" prefWidth="520"
                visible="false" managed="false"
                style="-fx-background-color: rgba(46,80,87,0.9);
                       -fx-background-radius: 16;
                       -fx-border-color: rgba(195,200,201,0.2);
                       -fx-border-radius: 16;
                       -fx-border-width: 1;
                       -fx-padding: 28;">

                <Label text="Edit Customer  —  Admin Only"
                    style="-fx-font-family: 'Jaldi';
                           -fx-font-size: 18;
                           -fx-font-weight: bold;
                           -fx-text-fill: white;"/>

                <Label fx:id="editingLabel" text=""
                    style="-fx-font-size: 13;
                           -fx-text-fill: rgba(195,200,201,0.6);"/>

                <!-- EMAIL -->
                <Label text="E-Mail Address"
                    style="-fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-text-fill: #C3C8C9;"/>
                <TextField fx:id="emailField"
                    prefHeight="44"
                    style="-fx-background-color: rgba(195,200,201,0.9);
                           -fx-background-radius: 10;
                           -fx-padding: 0 14;
                           -fx-font-size: 14;
                           -fx-text-fill: #1a1a1a;
                           -fx-control-inner-background:
                               rgba(195,200,201,0.9);"/>

                <!-- USER ID -->
                <Label text="User ID"
                    style="-fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-text-fill: #C3C8C9;"/>
                <TextField fx:id="userIdField"
                    prefHeight="44"
                    style="-fx-background-color: rgba(195,200,201,0.9);
                           -fx-background-radius: 10;
                           -fx-padding: 0 14;
                           -fx-font-size: 14;
                           -fx-text-fill: #1a1a1a;
                           -fx-control-inner-background:
                               rgba(195,200,201,0.9);"/>

                <!-- PHOTO ID -->
                <Label text="Photo ID / ID Card"
                    style="-fx-font-size: 13;
                           -fx-font-weight: bold;
                           -fx-text-fill: #C3C8C9;"/>
                <Label fx:id="currentIdLabel"
                    text="No file on record"
                    style="-fx-font-size: 11;
                           -fx-text-fill: rgba(195,200,201,0.5);"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button text="📁  Upload New ID"
                        onAction="#handleIdUpload"
                        prefHeight="38"
                        style="-fx-background-color: rgba(195,200,201,0.2);
                               -fx-background-radius: 10;
                               -fx-text-fill: #C3C8C9;
                               -fx-font-size: 13;
                               -fx-cursor: hand;
                               -fx-padding: 0 16;"/>
                    <Label fx:id="newIdLabel" text=""
                        style="-fx-font-size: 12;
                               -fx-text-fill: #15F06C;"/>
                </HBox>

                <!-- ACCOUNT STATUS -->
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel"
                        text="Active"
                        style="-fx-font-size: 13;
                               -fx-font-weight: bold;
                               -fx-text-fill: #4CAF50;"/>
                    <Button fx:id="toggleBtn"
                        text="Deactivate"
                        onAction="#handleToggle"
                        style="-fx-background-color: #F44336;
                               -fx-background-radius: 8;
                               -fx-text-fill: white;
                               -fx-font-size: 12;
                               -fx-cursor: hand;
                               -fx-padding: 6 16;"/>
                </HBox>

                <!-- MESSAGES -->
                <Label fx:id="errorLabel" text=""
                    wrapText="true"
                    style="-fx-text-fill: #ff6b6b;
                           -fx-font-size: 12;"/>
                <Label fx:id="successLabel" text=""
                    wrapText="true"
                    style="-fx-text-fill: #15F06C;
                           -fx-font-size: 12;"/>

                <!-- BUTTONS -->
                <HBox spacing="12">
                    <Button text="SAVE"
                        onAction="#handleSave"
                        prefHeight="44" prefWidth="160"
                        style="-fx-background-color: #1D7386;
                               -fx-background-radius: 10;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15;
                               -fx-cursor: hand;"/>
                    <Button text="Cancel"
                        onAction="#handleCancel"
                        prefHeight="44" prefWidth="100"
                        style="-fx-background-color: rgba(195,200,201,0.2);
                               -fx-background-radius: 10;
                               -fx-text-fill: #C3C8C9;
                               -fx-font-size: 15;
                               -fx-cursor: hand;"/>
                </HBox>

            </VBox>

        </HBox>
    </VBox>
</StackPane>