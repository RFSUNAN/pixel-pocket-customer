<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="PIXEL_POCKET.CUSTOMER.AccountSettings_Controller"
    prefWidth="1440"
    prefHeight="1027"
    style="-fx-background-color: linear-gradient(to bottom right, #1D7386, #7F9594);">

    <HBox>

        <!-- LEFT SIDEBAR -->
        <VBox prefWidth="390" prefHeight="1027" alignment="TOP_LEFT">

            <!-- HOME BUTTON -->
            <HBox prefHeight="60" alignment="CENTER_LEFT"
                style="-fx-padding: 20 0 0 20;">
                <Button onAction="#goToHome"
                    style="-fx-background-color: transparent;
                           -fx-cursor: hand;">
                    <graphic>
                        <Label text="⌂"
                            style="-fx-font-size: 28;
                                   -fx-text-fill: rgba(195,200,201,0.85);"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- BACK + TITLE -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                style="-fx-padding: 80 0 14 20;
                       -fx-border-color: transparent transparent
                           rgba(195,200,201,0.4) transparent;
                       -fx-border-width: 0 0 1 0;">
                <Button onAction="#goBack"
                    style="-fx-background-color: transparent;
                           -fx-cursor: hand;">
                    <graphic>
                        <Label text="←"
                            style="-fx-font-size: 22;
                                   -fx-text-fill: #C3C8C9;"/>
                    </graphic>
                </Button>
                <Label text="👥"
                    style="-fx-font-size: 20;
                           -fx-text-fill: #C3C8C9;"/>
                <Label text="Account Settings"
                    style="-fx-font-family: 'Jaldi';
                           -fx-font-size: 26;
                           -fx-font-weight: bold;
                           -fx-text-fill: #C3C8C9;"/>
            </HBox>

        </VBox>

        <!-- RIGHT DARK PANEL -->
        <VBox prefWidth="1050" prefHeight="1027" spacing="0"
            style="-fx-background-color: #2E5057;
                   -fx-background-radius: 60 0 0 0;">

            <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: transparent;
                       -fx-background-color: transparent;
                       -fx-border-color: transparent;">

                <VBox spacing="28"
                    style="-fx-padding: 60 80 60 80;
                           -fx-background-color: transparent;">

                    <!-- ══════════════════════════ -->
                    <!-- CHANGE PASSWORD            -->
                    <!-- ══════════════════════════ -->
                    <Label text="Change Password"
                        style="-fx-font-family: 'Jaldi';
                               -fx-font-size: 24;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>

                    <!-- PASSWORD FIELD -->
                    <StackPane prefHeight="52">
                        <PasswordField fx:id="passwordField"
                            promptText="Password"
                            prefHeight="52"
                            style="-fx-background-color: rgba(195,200,201,0.85);
                                   -fx-background-radius: 26;
                                   -fx-padding: 0 50 0 20;
                                   -fx-font-size: 16;
                                   -fx-prompt-text-fill: #3a5a5f;
                                   -fx-text-fill: #1a1a1a;
                                   -fx-control-inner-background:
                                       rgba(195,200,201,0.85);"/>
                        <TextField fx:id="passwordVisible"
                            promptText="Password"
                            prefHeight="52"
                            visible="false" managed="false"
                            style="-fx-background-color: rgba(195,200,201,0.85);
                                   -fx-background-radius: 26;
                                   -fx-padding: 0 50 0 20;
                                   -fx-font-size: 16;
                                   -fx-prompt-text-fill: #3a5a5f;
                                   -fx-text-fill: #1a1a1a;
                                   -fx-control-inner-background:
                                       rgba(195,200,201,0.85);"/>
                        <Button text="👁"
                            onAction="#togglePassword"
                            style="-fx-background-color: transparent;
                                   -fx-cursor: hand;
                                   -fx-font-size: 16;"
                            StackPane.alignment="CENTER_RIGHT"
                            translateX="-16"/>
                    </StackPane>

                    <!-- CONFIRM PASSWORD FIELD -->
                    <StackPane prefHeight="52">
                        <PasswordField fx:id="confirmPasswordField"
                            promptText="Confirm Password"
                            prefHeight="52"
                            style="-fx-background-color: rgba(195,200,201,0.85);
                                   -fx-background-radius: 26;
                                   -fx-padding: 0 50 0 20;
                                   -fx-font-size: 16;
                                   -fx-prompt-text-fill: #3a5a5f;
                                   -fx-text-fill: #1a1a1a;
                                   -fx-control-inner-background:
                                       rgba(195,200,201,0.85);"/>
                        <TextField fx:id="confirmVisible"
                            promptText="Confirm Password"
                            prefHeight="52"
                            visible="false" managed="false"
                            style="-fx-background-color: rgba(195,200,201,0.85);
                                   -fx-background-radius: 26;
                                   -fx-padding: 0 50 0 20;
                                   -fx-font-size: 16;
                                   -fx-prompt-text-fill: #3a5a5f;
                                   -fx-text-fill: #1a1a1a;
                                   -fx-control-inner-background:
                                       rgba(195,200,201,0.85);"/>
                        <Button text="👁"
                            onAction="#toggleConfirm"
                            style="-fx-background-color: transparent;
                                   -fx-cursor: hand;
                                   -fx-font-size: 16;"
                            StackPane.alignment="CENTER_RIGHT"
                            translateX="-16"/>
                    </StackPane>

                    <!-- FORGOT PASSWORD -->
                    <HBox alignment="CENTER_RIGHT">
                        <Hyperlink text="Forget Password ?"
                            onAction="#handleForgotPassword"
                            style="-fx-text-fill: #C3C8C9;
                                   -fx-font-size: 13;
                                   -fx-font-weight: bold;
                                   -fx-border-color: transparent;"/>
                    </HBox>

                    <!-- PASSWORD ERROR/SUCCESS -->
                    <Label fx:id="passwordErrorLabel" text=""
                        wrapText="true"
                        style="-fx-text-fill: #ff6b6b;
                               -fx-font-size: 12;"/>
                    <Label fx:id="passwordSuccessLabel" text=""
                        wrapText="true"
                        style="-fx-text-fill: #15F06C;
                               -fx-font-size: 12;"/>

                    <!-- CHANGE PASSWORD BUTTON -->
                    <HBox alignment="CENTER">
                        <Button text="CHANGE PASSWORD"
                            onAction="#handleChangePassword"
                            prefWidth="320" prefHeight="50"
                            style="-fx-background-color: #7F9594;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 16;
                                   -fx-background-radius: 26;
                                   -fx-cursor: hand;"/>
                    </HBox>

                    <!-- ══════════════════════════ -->
                    <!-- ACCOUNT DEACTIVATE         -->
                    <!-- ══════════════════════════ -->
                    <Label text="Account Deactivate"
                        style="-fx-font-family: 'Jaldi';
                               -fx-font-size: 24;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>

                    <!-- WARNING BOX -->
                    <VBox spacing="12"
                        style="-fx-background-color: rgba(195,200,201,0.15);
                               -fx-background-radius: 16;
                               -fx-border-color: #C3C8C9;
                               -fx-border-radius: 16;
                               -fx-border-width: 1;
                               -fx-padding: 24 28;">

                        <Label text="Account closure is a permanent action"
                            wrapText="true"
                            style="-fx-font-family: 'Jaldi';
                                   -fx-font-size: 22;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #e53935;"/>

                        <Label
                            text="Please note that account closure is a permanent action and once your account has been closed, it will no longer be available to you and cannot be restored. If you decide later that you want to start ordering from us again, or if you would like to use products and services that require an account, you will need to create a new account."
                            wrapText="true"
                            style="-fx-font-size: 14;
                                   -fx-text-fill: #e53935;
                                   -fx-line-spacing: 4;"/>
                    </VBox>

                    <!-- REASON LABEL -->
                    <Label
                        text="Please select the main reason for closing your Pixel-Pocket account (Optional)"
                        wrapText="true"
                        style="-fx-font-family: 'Jaldi';
                               -fx-font-size: 16;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>

                    <!-- REASON DROPDOWN -->
                    <ComboBox fx:id="deactivateReasonCombo"
                        prefHeight="52"
                        prefWidth="99999"
                        style="-fx-background-color: rgba(195,200,201,0.2);
                               -fx-background-radius: 10;
                               -fx-border-color: rgba(195,200,201,0.4);
                               -fx-border-radius: 10;
                               -fx-border-width: 1;
                               -fx-font-size: 14;
                               -fx-text-fill: #C3C8C9;"/>

                    <!-- CONFIRMATION CHECKBOX -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <CheckBox fx:id="confirmDeactivateCheck"
                            style="-fx-cursor: hand;"/>
                        <Label
                            text="Yes, I want to permanently close my Pixel-Pocket Account and delete my data."
                            wrapText="true"
                            style="-fx-font-size: 14;
                                   -fx-text-fill: #C3C8C9;"/>
                    </HBox>

                    <!-- DEACTIVATE ERROR -->
                    <Label fx:id="deactivateErrorLabel" text=""
                        wrapText="true"
                        style="-fx-text-fill: #ff6b6b;
                               -fx-font-size: 12;"/>

                    <!-- DEACTIVATE BUTTON -->
                    <HBox alignment="CENTER">
                        <Button text="DEACTIVATE"
                            onAction="#handleDeactivate"
                            prefWidth="280" prefHeight="50"
                            style="-fx-background-color: #7F9594;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-font-size: 16;
                                   -fx-background-radius: 26;
                                   -fx-cursor: hand;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>

    </HBox>
</StackPane>